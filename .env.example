# Required: APInex API key (https://apinex.bond)
# (GEMINI_API_KEY is also accepted as a backward-compatible fallback)
APINEX_API_KEY=

# Required for internet search; if omitted, regular AI answers still work
SERPER_API_KEY=

# Optional: model name from APInex. Default is free/gemini-3.8-flash
APINEX_MODEL=free/gemini-3.8-flash
